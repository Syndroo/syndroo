{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "syndroo",
  "main": "apps/cloudflare-worker/src/index.ts",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": [
      "SYNDROO_API_KEY",
      "BLUESKY_IDENTIFIER",
      "BLUESKY_PASSWORD",
      "BLUESKY_HOST",
      "THREADS_ACCESS_TOKEN"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "syndroo",
      "migrations_dir": "apps/cloudflare-worker/migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "PUBLICATION_QUEUE",
        "queue": "syndroo-publications"
      }
    ],
    "consumers": [
      {
        "queue": "syndroo-publications",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 2,
        "retry_delay": 60
      }
    ]
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
