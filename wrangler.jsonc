{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "syndroo",
  // The Worker is a bundle: build it first with
  // `npm run build --workspace @syndroo/cloudflare`. The bundle inlines Core and
  // the official providers, so `nodejs_compat` is deliberately absent — the
  // bundle gate refuses any `node:` import.
  "main": "packages/cloudflare/dist/worker.js",
  "compatibility_date": "2026-09-02",
  // Required by packages/cloudflare/src/transport.ts: the Worker must not be
  // able to fetch a private or loopback address.
  "compatibility_flags": ["global_fetch_strictly_public"],
  "vars": {
    "QUEUE_NAME": "syndroo-work",
    "DLQ_NAME": "syndroo-dead",
    "SCOPE": "default",
    // `assertEnv` refuses to start unless this is exactly `enabled`.
    "PUBLIC_FETCH_STRICT": "enabled"
  },
  // These are the only secrets the v1 Worker reads. Provider credentials are
  // not deployment configuration; they are created by `syndroo connect` and
  // stored encrypted under SECRET_KEY.
  "secrets": {
    "required": ["API_BEARER", "SECRET_KEY", "RUNTIME_KEY"]
  },
  // No migrations directory: the D1 schema is created on demand by
  // createD1Storage, so a fresh deployment answers `status` with a durability
  // error until the first `connect` initializes storage.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "syndroo"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "WORK_QUEUE",
        "queue": "syndroo-work"
      }
    ],
    "consumers": [
      {
        "queue": "syndroo-work",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 2,
        "retry_delay": 60
      },
      {
        // The dead-letter consumer only acknowledges and classifies messages
        // that exhausted their retries; it must never retry them.
        "queue": "syndroo-dead",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 0
      }
    ]
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
