{
  "name": "syndroo",
  "version": "0.7.0-rc.1",
  "private": true,
  "type": "module",
  "description": "Syndroo: local-first publishing CLI, standalone HTTP SDK, Node server, Cloudflare Worker and official Provider plugins. Architecture v1 is under construction and not released.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Syndroo/syndroo.git"
  },
  "bugs": {
    "url": "https://github.com/Syndroo/syndroo/issues"
  },
  "homepage": "https://github.com/Syndroo/syndroo#readme",
  "cloudflare": {
    "bindings": {
      "API_BEARER": {
        "description": "Choose a long random string. API clients send it as the Syndroo Bearer token."
      },
      "SECRET_KEY": {
        "description": "A long random string that encrypts stored provider credentials."
      },
      "RUNTIME_KEY": {
        "description": "A long random string used to derive opaque runtime identifiers."
      },
      "SCOPE": {
        "description": "Namespace for this deployment's rows and objects, for example `default`."
      },
      "QUEUE_NAME": {
        "description": "Work queue name this Worker consumes, for example `syndroo-work`."
      },
      "DLQ_NAME": {
        "description": "Dead-letter queue name; must differ from QUEUE_NAME."
      },
      "PUBLIC_FETCH_STRICT": {
        "description": "Set the literal value `enabled`; any other value refuses to start."
      }
    }
  },
  "workspaces": [
    "packages/provider-sdk",
    "packages/core",
    "packages/sdk",
    "packages/cli",
    "packages/server",
    "packages/cloudflare",
    "packages/provider-bluesky",
    "packages/provider-threads",
    "packages/provider-linkedin",
    "packages/provider-mastodon",
    "packages/provider-devto"
  ],
  "scripts": {
    "build": "node scripts/build-v1.ts",
    "build:allow-missing": "node scripts/build-v1.ts --allow-missing",
    "check": "npm run check:v1-tools && node scripts/check-v1.ts",
    "check:allow-missing": "npm run check:v1-tools && node scripts/check-v1.ts --allow-missing",
    "check:v1-tools": "tsc -p tsconfig.v1-tools.json",
    "check:pack": "npm run check:v1-tools && node scripts/check-v1.ts --pack",
    "check:pack:allow-missing": "npm run check:v1-tools && node scripts/check-v1.ts --pack --allow-missing",
    "test": "node scripts/check-v1.ts --tests",
    "test:allow-missing": "node scripts/check-v1.ts --tests --allow-missing",
    "test:v1": "vitest run --config vitest.v1.config.ts",
    "generate:protocol": "node scripts/generate-protocol.ts",
    "generate:provider-catalog": "node scripts/generate-provider-catalog.ts",
    "check:provider-catalog": "node scripts/generate-provider-catalog.ts --check",
    "build:scripts": "tsc -p tsconfig.scripts.json",
    "check:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "check:e2e": "tsc -p e2e/local-only/tsconfig.json --noEmit",
    "dco:check": "npm run build:scripts && node .build/scripts/check-dco.js",
    "test:scripts": "npm run build:scripts && node --test --test-concurrency=1 .build/scripts/check-release.spec.js .build/scripts/release-train.spec.js .build/scripts/package-licenses.spec.js .build/scripts/cli-licenses.spec.js .build/scripts/cli-artifact.spec.js .build/scripts/v1-stages.spec.js .build/scripts/bundle-v1-cli.spec.js .build/scripts/bundle-v1-server.spec.js .build/scripts/bundle-v1-cloudflare.spec.js",
    "release:check": "npm run build:scripts && node .build/scripts/check-release.js",
    "release:train": "npm run build:scripts && node .build/scripts/release-train.js",
    "e2e:local-only:build": "tsc -p e2e/local-only/tsconfig.json",
    "e2e:local-only": "npm run e2e:local-only:build && node .build/e2e-local-only/runner.js"
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260915.1",
    "@types/node": "^26.4.0",
    "jsonc-parser": "^3.3.1",
    "miniflare": "^5.20260915.0-alpha",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.132.0"
  }
}
