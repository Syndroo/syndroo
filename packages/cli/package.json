{
  "name": "@syndroo/cli",
  "version": "0.7.0-rc.1",
  "type": "module",
  "description": "Local-first Syndroo CLI: connect, prepare, confirm, execute and query status for content publishing.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Syndroo/syndroo.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/Syndroo/syndroo/issues"
  },
  "homepage": "https://github.com/Syndroo/syndroo#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    }
  },
  "bin": {
    "syndroo": "./dist/bin.js"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "skills",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=24.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@syndroo/provider-sdk": "0.7.0-rc.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "commander": "13.1.0"
  },
  "devDependencies": {
    "@syndroo/core": "0.7.0-rc.1",
    "@types/node": "^26.4.0",
    "esbuild": "0.28.1"
  },
  "scripts": {
    "build": "node ../../scripts/bundle-v1-cli.ts",
    "build:types": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "prepack": "npm run build"
  }
}
