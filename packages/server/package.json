{
  "name": "@syndroo/server",
  "version": "0.7.0-rc.1",
  "type": "module",
  "description": "Self-hosted Syndroo server: authenticated HTTP API, SQLite state and encrypted secrets.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Syndroo/syndroo.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/Syndroo/syndroo/issues"
  },
  "homepage": "https://github.com/Syndroo/syndroo#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }, "./http": { "types": "./dist/http/index.d.ts", "import": "./dist/http/index.js" } },
  "sideEffects": false,
  "files": ["dist", "LICENSE", "NOTICE"],
  "engines": {
    "node": ">=24.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": { "@syndroo/cli": "0.7.0-rc.1", "@syndroo/provider-sdk": "0.7.0-rc.1" },
  "devDependencies": { "@syndroo/core": "0.7.0-rc.1", "@types/node": "^26.4.0", "esbuild": "0.28.1" },
  "scripts": {
    "build": "node ../../scripts/bundle-v1-server.ts",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "prepack": "npm run build"
  }
}
