{
  "name": "@syndroo/sdk",
  "version": "0.4.0-rc.1",
  "type": "module",
  "description": "Lightweight TypeScript HTTP client for the Syndroo publishing API.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Syndroo/syndroo.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/Syndroo/syndroo/issues"
  },
  "homepage": "https://github.com/Syndroo/syndroo#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "prepack": "npm run build"
  }
}
