{
  "name": "@syndroo/cloudflare-worker",
  "version": "0.5.0-rc.1",
  "type": "module",
  "description": "Self-hosted Syndroo publishing Worker for Cloudflare.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Syndroo/syndroo.git",
    "directory": "packages/cloudflare-worker"
  },
  "bugs": {
    "url": "https://github.com/Syndroo/syndroo/issues"
  },
  "homepage": "https://github.com/Syndroo/syndroo#readme",
  "main": "./dist/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "syndroo-deploy": "./dist/deploy.js"
  },
  "files": [
    "dist",
    "licenses",
    "migrations",
    "types",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "scripts": {
    "build:package": "npm run bundle && npm run build:deploy && npm run licenses",
    "build:deploy": "tsc -p tsconfig.deploy.json",
    "licenses": "node ../../.build/scripts/generate-package-licenses.js",
    "types": "wrangler types worker-configuration.d.ts --config ../../wrangler.jsonc",
    "check": "npm run types && tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "test": "node test/support/run-worker-tests.ts",
    "test:worker:main": "vitest run",
    "test:worker:canary": "vitest run --config test/canary-v050.vitest.config.ts",
    "test:worker:watchdog": "vitest run --config test/host-v050.vitest.config.ts",
    "dev": "wrangler dev --env local --config ../../wrangler.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config ../../wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config ../../wrangler.jsonc",
    "bundle": "npm run build:scripts --prefix ../.. && node ../../.build/scripts/bundle-worker.js",
    "startup": "wrangler check startup --config ../../wrangler.jsonc",
    "prepack": "npm run build:package --prefix ../.."
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.10",
    "@syndroo/application": "0.1.0",
    "@syndroo/bluesky": "0.1.0",
    "@syndroo/core": "0.1.0",
    "@syndroo/threads": "0.1.0",
    "@syndroo/x": "0.1.0",
    "@syndroo/tumblr": "0.1.0",
    "@syndroo/linkedin": "0.1.0",
    "@syndroo/transport": "0.1.0"
  }
}
