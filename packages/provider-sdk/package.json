{
  "name": "@syndroo/provider-sdk",
  "version": "0.7.0-rc.1",
  "type": "module",
  "description": "Public Provider contract and defineProvider validation for Syndroo architecture v1.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Syndroo/syndroo.git",
    "directory": "packages/provider-sdk"
  },
  "bugs": {
    "url": "https://github.com/Syndroo/syndroo/issues"
  },
  "homepage": "https://github.com/Syndroo/syndroo#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=24.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "prepack": "npm run build"
  }
}
