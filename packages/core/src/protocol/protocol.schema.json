{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Json": {},
    "JsonObject": {
      "type": "object"
    },
    "Schema": {
      "type": "object"
    },
    "Content": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "TargetInput": {
      "type": "object",
      "properties": {
        "provider": {
          "$ref": "#/$defs/ProviderId"
        },
        "connection": {
          "type": "string"
        },
        "content": {
          "$ref": "#/$defs/Content"
        },
        "options": {
          "$ref": "#/$defs/JsonObject"
        }
      },
      "required": [
        "provider"
      ],
      "additionalProperties": false
    },
    "ProviderId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "PostDocument": {
      "type": "object",
      "properties": {
        "content": {
          "$ref": "#/$defs/Content"
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TargetInput"
          },
          "minItems": 1,
          "maxItems": 20
        }
      },
      "required": [
        "content",
        "targets"
      ],
      "additionalProperties": false
    },
    "PrepareRequest": {
      "type": "object",
      "properties": {
        "content": {
          "$ref": "#/$defs/Content"
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TargetInput"
          },
          "minItems": 1,
          "maxItems": 20
        },
        "type": {
          "const": "prepare"
        }
      },
      "required": [
        "content",
        "targets",
        "type"
      ],
      "additionalProperties": false
    },
    "ExecuteRequest": {
      "type": "object",
      "properties": {
        "type": {
          "const": "execute"
        },
        "approvalToken": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "approvalToken"
      ],
      "additionalProperties": false
    },
    "RetryRequest": {
      "type": "object",
      "properties": {
        "type": {
          "const": "retry"
        },
        "retryOf": {
          "$ref": "#/$defs/OperationId"
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "provider": {
                "$ref": "#/$defs/ProviderId"
              },
              "connection": {
                "$ref": "#/$defs/ConnectionId"
              }
            },
            "required": [
              "provider",
              "connection"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 20
        }
      },
      "required": [
        "type",
        "retryOf",
        "targets"
      ],
      "additionalProperties": false
    },
    "OperationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "ConnectionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "PublishRequest": {
      "anyOf": [
        {
          "$ref": "#/$defs/PrepareRequest"
        },
        {
          "$ref": "#/$defs/ExecuteRequest"
        },
        {
          "$ref": "#/$defs/RetryRequest"
        }
      ]
    },
    "SessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "Revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "CredentialBundle": {
      "$ref": "#/$defs/JsonObject"
    },
    "ConnectRequest": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "start"
            },
            "provider": {
              "$ref": "#/$defs/ProviderId"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^(?!conn_)[^\\u0000-\\u001f\\u007f]+$"
            },
            "connectionId": {
              "$ref": "#/$defs/ConnectionId"
            },
            "options": {
              "$ref": "#/$defs/JsonObject"
            }
          },
          "required": [
            "type",
            "provider"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "resume"
            },
            "connectSessionId": {
              "$ref": "#/$defs/SessionId"
            },
            "stepRevision": {
              "$ref": "#/$defs/Revision"
            },
            "input": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "credentials"
                    },
                    "credentials": {
                      "$ref": "#/$defs/CredentialBundle"
                    }
                  },
                  "required": [
                    "type",
                    "credentials"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "callback_complete"
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "type",
            "connectSessionId",
            "stepRevision",
            "input"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "update"
            },
            "connectionId": {
              "$ref": "#/$defs/ConnectionId"
            },
            "changes": {
              "type": "object",
              "properties": {
                "label": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^(?!conn_)[^\\u0000-\\u001f\\u007f]+$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "isDefault": {
                  "type": "boolean"
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "connectionId",
            "changes"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "disconnect"
            },
            "connectionId": {
              "$ref": "#/$defs/ConnectionId"
            }
          },
          "required": [
            "type",
            "connectionId"
          ],
          "additionalProperties": false
        }
      ]
    },
    "StatusRequest": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "overview"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "provider"
            },
            "provider": {
              "$ref": "#/$defs/ProviderId"
            }
          },
          "required": [
            "type",
            "provider"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "connections"
            },
            "provider": {
              "$ref": "#/$defs/ProviderId"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "operation"
            },
            "operationId": {
              "$ref": "#/$defs/OperationId"
            }
          },
          "required": [
            "type",
            "operationId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "operations"
            },
            "limit": {
              "type": "number"
            },
            "cursor": {
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      ]
    },
    "IsoTime": {
      "type": "string",
      "format": "date-time"
    },
    "ConnectAction": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "credential_input"
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "secret": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "name",
                  "label",
                  "secret"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "type",
            "fields"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "open_url"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "url"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "wait_for_callback"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ConnectionView": {
      "type": "object",
      "properties": {
        "connectionId": {
          "$ref": "#/$defs/ConnectionId"
        },
        "account": {
          "$ref": "#/$defs/AccountIdentity"
        },
        "label": {
          "type": "string"
        },
        "isDefault": {
          "type": "boolean"
        },
        "active": {
          "type": "boolean"
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "capability": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Capability"
                  },
                  {
                    "const": "identity"
                  },
                  {
                    "const": "publish_permission"
                  }
                ]
              },
              "value": {
                "anyOf": [
                  {
                    "const": "supported"
                  },
                  {
                    "const": "unsupported"
                  },
                  {
                    "const": "unknown"
                  }
                ]
              },
              "source": {
                "type": "string"
              },
              "verifiedAt": {
                "$ref": "#/$defs/IsoTime"
              },
              "expiresAt": {
                "$ref": "#/$defs/IsoTime"
              },
              "account": {
                "$ref": "#/$defs/AccountIdentity"
              },
              "credentialRevision": {
                "$ref": "#/$defs/Revision"
              },
              "artifactFingerprint": {
                "$ref": "#/$defs/Digest"
              },
              "schemaFingerprint": {
                "$ref": "#/$defs/Digest"
              },
              "stale": {
                "type": "boolean"
              }
            },
            "required": [
              "capability",
              "value",
              "source",
              "verifiedAt",
              "account",
              "credentialRevision",
              "artifactFingerprint",
              "schemaFingerprint",
              "stale"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "connectionId",
        "account",
        "isDefault",
        "active",
        "observations"
      ],
      "additionalProperties": false
    },
    "AccountIdentity": {
      "type": "object",
      "properties": {
        "provider": {
          "$ref": "#/$defs/ProviderId"
        },
        "accountId": {
          "type": "string"
        },
        "origin": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "accountId",
        "origin"
      ],
      "additionalProperties": false
    },
    "Capability": {
      "anyOf": [
        {
          "const": "text"
        },
        {
          "const": "article"
        }
      ]
    },
    "Digest": {
      "type": "string"
    },
    "ConnectResult": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "action_required"
            },
            "connectSessionId": {
              "$ref": "#/$defs/SessionId"
            },
            "stepRevision": {
              "$ref": "#/$defs/Revision"
            },
            "expiresAt": {
              "$ref": "#/$defs/IsoTime"
            },
            "action": {
              "$ref": "#/$defs/ConnectAction"
            }
          },
          "required": [
            "status",
            "connectSessionId",
            "stepRevision",
            "expiresAt",
            "action"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "done"
            },
            "connection": {
              "$ref": "#/$defs/ConnectionView"
            }
          },
          "required": [
            "status",
            "connection"
          ],
          "additionalProperties": false
        }
      ]
    },
    "TargetPreview": {
      "type": "object",
      "properties": {
        "deliveryId": {
          "type": "string"
        },
        "connectionId": {
          "$ref": "#/$defs/ConnectionId"
        },
        "account": {
          "$ref": "#/$defs/AccountIdentity"
        },
        "provider": {
          "$ref": "#/$defs/ProviderId"
        },
        "preview": {
          "$ref": "#/$defs/ProviderPreview"
        }
      },
      "required": [
        "deliveryId",
        "connectionId",
        "account",
        "provider",
        "preview"
      ],
      "additionalProperties": false
    },
    "ProviderPreview": {
      "type": "object",
      "properties": {
        "content": {
          "$ref": "#/$defs/Content"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PreviewField"
          }
        }
      },
      "required": [
        "content",
        "fields"
      ],
      "additionalProperties": false
    },
    "PreviewField": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/Json"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "additionalProperties": false
    },
    "PreparedResult": {
      "type": "object",
      "properties": {
        "status": {
          "const": "confirmation_required"
        },
        "operationId": {
          "$ref": "#/$defs/OperationId"
        },
        "approvalToken": {
          "type": "string"
        },
        "expiresAt": {
          "$ref": "#/$defs/IsoTime"
        },
        "preview": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TargetPreview"
          }
        }
      },
      "required": [
        "status",
        "operationId",
        "approvalToken",
        "expiresAt",
        "preview"
      ],
      "additionalProperties": false
    },
    "ExecutionStatus": {
      "anyOf": [
        {
          "const": "pending"
        },
        {
          "const": "running"
        },
        {
          "const": "succeeded"
        },
        {
          "const": "partial"
        },
        {
          "const": "failed"
        },
        {
          "const": "unknown"
        }
      ]
    },
    "DeliveryResult": {
      "type": "object",
      "properties": {
        "deliveryId": {
          "type": "string"
        },
        "connectionId": {
          "$ref": "#/$defs/ConnectionId"
        },
        "account": {
          "$ref": "#/$defs/AccountIdentity"
        },
        "attempts": {
          "type": "number"
        },
        "outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderWriteOutcome"
            },
            {
              "$ref": "#/$defs/NotStarted"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "deliveryId",
        "connectionId",
        "account",
        "attempts",
        "outcome"
      ],
      "additionalProperties": false
    },
    "ProviderWriteOutcome": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "succeeded"
            },
            "remoteId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "url": {
              "type": "string",
              "format": "uri",
              "maxLength": 2048,
              "pattern": "^https://"
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "failed"
            },
            "disposition": {
              "const": "not_applied"
            },
            "retryable": {
              "type": "boolean"
            },
            "reason": {
              "$ref": "#/$defs/ProviderFailureReason"
            },
            "retryAfter": {
              "$ref": "#/$defs/IsoTime"
            }
          },
          "required": [
            "status",
            "disposition",
            "retryable",
            "reason"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "unknown"
            },
            "disposition": {
              "const": "unknown"
            },
            "reason": {
              "$ref": "#/$defs/ProviderFailureReason"
            }
          },
          "required": [
            "status",
            "disposition",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ProviderFailureReason": {
      "anyOf": [
        {
          "const": "auth"
        },
        {
          "const": "validation"
        },
        {
          "const": "rate_limited"
        },
        {
          "const": "provider_unavailable"
        },
        {
          "const": "network"
        },
        {
          "const": "permission"
        },
        {
          "const": "unsupported"
        },
        {
          "const": "unknown"
        }
      ]
    },
    "NotStarted": {
      "type": "object",
      "properties": {
        "status": {
          "const": "not_started"
        },
        "disposition": {
          "const": "not_applied"
        },
        "reason": {
          "anyOf": [
            {
              "const": "cancelled_before_start"
            },
            {
              "const": "execution_interrupted"
            },
            {
              "const": "stale_binding"
            },
            {
              "const": "stale_implementation"
            }
          ]
        }
      },
      "required": [
        "status",
        "disposition",
        "reason"
      ],
      "additionalProperties": false
    },
    "ExecutionResult": {
      "type": "object",
      "properties": {
        "phase": {
          "const": "execution"
        },
        "operationId": {
          "$ref": "#/$defs/OperationId"
        },
        "status": {
          "$ref": "#/$defs/ExecutionStatus"
        },
        "deliveries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DeliveryResult"
          }
        },
        "durabilityWarning": {
          "const": "OUTCOME_NOT_DURABLE"
        }
      },
      "required": [
        "phase",
        "operationId",
        "status",
        "deliveries"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "status": {
            "const": "succeeded"
          }
        }
      },
      "then": {
        "properties": {
          "deliveries": {
            "minItems": 1,
            "items": {
              "properties": {
                "outcome": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "succeeded"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              },
              "required": [
                "outcome"
              ]
            }
          }
        }
      },
      "else": {
        "if": {
          "properties": {
            "status": {
              "not": {
                "const": "unknown"
              }
            }
          }
        },
        "then": {
          "properties": {
            "deliveries": {
              "not": {
                "contains": {
                  "properties": {
                    "outcome": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "const": "unknown"
                        }
                      },
                      "required": [
                        "status"
                      ]
                    }
                  },
                  "required": [
                    "outcome"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "OperationView": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExecutionResult"
        },
        {
          "type": "object",
          "properties": {
            "phase": {
              "const": "prepared"
            },
            "operationId": {
              "$ref": "#/$defs/OperationId"
            },
            "confirmation": {
              "anyOf": [
                {
                  "const": "required"
                },
                {
                  "const": "expired"
                }
              ]
            },
            "expiresAt": {
              "$ref": "#/$defs/IsoTime"
            },
            "preview": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/TargetPreview"
              }
            }
          },
          "required": [
            "phase",
            "operationId",
            "confirmation",
            "expiresAt",
            "preview"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Implementation": {
      "type": "object",
      "properties": {
        "provider": {
          "$ref": "#/$defs/ProviderId"
        },
        "packageName": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "apiVersion": {
          "const": 1
        },
        "artifactFingerprint": {
          "$ref": "#/$defs/Digest"
        },
        "schemaFingerprint": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "provider",
        "packageName",
        "version",
        "apiVersion",
        "artifactFingerprint",
        "schemaFingerprint"
      ],
      "additionalProperties": false
    },
    "ProviderManifest": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/ProviderId"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "apiVersion": {
          "const": 1
        },
        "declaredCapabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Capability"
          }
        },
        "egress": {
          "$ref": "#/$defs/ProviderEgress"
        },
        "schemas": {
          "type": "object",
          "properties": {
            "connectOptions": {
              "$ref": "#/$defs/Schema"
            },
            "credentialInput": {
              "$ref": "#/$defs/Schema"
            },
            "content": {
              "$ref": "#/$defs/Schema"
            },
            "publishOptions": {
              "$ref": "#/$defs/Schema"
            }
          },
          "required": [
            "connectOptions",
            "credentialInput",
            "content",
            "publishOptions"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "name",
        "version",
        "apiVersion",
        "declaredCapabilities",
        "egress",
