  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "dependencies": {
    "@syndroo/provider-sdk": "0.7.0-rc.1",
