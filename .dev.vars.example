# Copy to .dev.vars. Never commit real values.
SYNDROO_API_KEY=replace-with-a-long-random-secret

# Optional: configure both credentials to enable Bluesky.
BLUESKY_IDENTIFIER=your-handle.bsky.social
BLUESKY_PASSWORD=your-bluesky-app-password
BLUESKY_HOST=bsky.social

# Optional: configure this token to enable Threads.
THREADS_ACCESS_TOKEN=your-long-lived-threads-user-access-token

# Optional: configure all four OAuth 1.0a credentials to enable X.
X_API_KEY=your-x-consumer-key
X_API_SECRET=your-x-consumer-secret
X_ACCESS_TOKEN=your-x-user-access-token
X_ACCESS_TOKEN_SECRET=your-x-user-access-token-secret

# Optional: configure all five values to enable Tumblr.
TUMBLR_CONSUMER_KEY=your-tumblr-consumer-key
TUMBLR_CONSUMER_SECRET=your-tumblr-consumer-secret
TUMBLR_TOKEN=your-tumblr-user-token
TUMBLR_TOKEN_SECRET=your-tumblr-user-token-secret
TUMBLR_BLOG=your-blog-name

# Optional: configure all three values to enable LinkedIn.
LINKEDIN_ACCESS_TOKEN=your-linkedin-user-access-token
LINKEDIN_AUTHOR=urn:li:person:your-member-id
# Explicitly select a supported version; update before LinkedIn retires it.
LINKEDIN_API_VERSION=202604

# ---------------------------------------------------------------------------
# Agent-guided OAuth (optional – only needed for the /v1/auth/:platform/connect
# flow; direct credential submission via POST /v1/auth/:platform works without
# these).
# ---------------------------------------------------------------------------

# X and Tumblr: consumer key/secret stay here; user access tokens are stored
# in D1 after the OAuth flow completes (X_API_KEY / TUMBLR_CONSUMER_KEY above
# already serve as the app credentials – no extra keys needed).

# LinkedIn OAuth 2.0 app credentials (required for /v1/auth/linkedin/connect).
# Register a LinkedIn app at https://developer.linkedin.com and add
# https://<your-worker-domain>/v1/auth/linkedin/callback as a redirect URL.
LINKEDIN_CLIENT_ID=your-linkedin-oauth-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-oauth-client-secret
